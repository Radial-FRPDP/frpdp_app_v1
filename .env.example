# --- Supabase ---------------------------------------------------------
# Settings -> API in your Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings -> API -> service_role (server-only, NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) -----------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Batch 1 Screening <noreply@yourdomain.example>"
PROGRAM_COORDINATOR_EMAIL=coordinator@yourdomain.example

# --- NIN verification provider ------------------------------------------
# "dojah" is the only implementation wired up today; the interface in
# src/lib/verification/provider.ts makes swapping providers a config
# change, not a code change.
NIN_PROVIDER=dojah
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# "sandbox" hits Dojah's test endpoint (fake data, no cost, no approval
# needed). Switch to "production" once your Dojah KYB review clears.
DOJAH_ENV=sandbox

# --- BVN verification (Paystack Identity) --------------------------------
# Dashboard -> Settings -> API Keys & Webhooks -> Secret Key.
# resolve_bvn is a gated Paystack Identity product — your Paystack account
# needs BVN-lookup access approved before this works in live mode. Test-mode
# secret keys (sk_test_...) hit Paystack's sandbox and don't need approval.
PAYSTACK_SECRET_KEY=

# --- App ------------------------------------------------------------------
# Public URL of the deployed app, used in invite/notification emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
